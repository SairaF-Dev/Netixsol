# PostgreSQL
DATABASE_URL=postgresql://postgres:Postgres123!@localhost:5432/real_estate
# OpenRouter / grounded RAG answer generation
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# RAG configuration
RAG_CHUNK_SIZE=512
RAG_OVERLAP_SENTENCES=1
RAG_TOP_K=4
RAG_DISTANCE_THRESHOLD=0.50
RAG_COLLECTION=real_estate_knowledge_v3