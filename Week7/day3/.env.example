# Copy this file to .env and fill real values.
# Never commit or send the populated .env file.

# Day 2 project root (contains 03_structured_retrieval, 04_recommendation, etc.)
DAY2_ROOT=../day2

# PostgreSQL
DATABASE_URL=postgresql://postgres:Postgres123!@localhost:5432/real_estate

# OpenRouter / OpenAI-compatible semantic NLU
OPENROUTER_API_KEY=


OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SARA_LLM_MODEL=openai/gpt-4o-mini
SARA_NLU_MAX_TOKENS=320
SARA_LLM_TIMEOUT_SECONDS=20
SARA_LLM_MAX_RETRIES=1


# Day 2 RAG (semantic FAQs / brochures / project descriptions)
SARA_RAG_ENABLED=1
# 0 = fail closed but keep structured search running if RAG is unavailable
# 1 = initialize RAG during startup and fail startup if it cannot load
SARA_RAG_REQUIRED=0
# Optional eager warmup even when RAG is not required
SARA_RAG_WARM_ON_STARTUP=0
# Leave blank to use DAY2_ROOT/02_rag/documents
SARA_RAG_DOCUMENTS_DIR=
# Leave blank to use DAY2_ROOT/02_rag/chroma_db
SARA_RAG_PERSIST_DIRECTORY=
SARA_RAG_CHUNK_SIZE=512
SARA_RAG_TOP_K=3
# Leave blank to use Day 2 retriever default
SARA_RAG_DISTANCE_THRESHOLD=
# Used by the finalized Day 2 RAG pipeline if supported
RAG_MAX_TOKENS=160

# Conversation / API runtime
SARA_RESPONSE_MODE=chat
SARA_RESULT_BATCH_SIZE=5
SARA_CHOICE_PREVIEW_SIZE=5
SARA_MAX_CANDIDATES=100
SARA_SESSION_TTL_SECONDS=3600
SARA_MAX_SESSIONS=500
SARA_MAX_AUDIO_BYTES=10485760
SARA_LOG_LEVEL=WARNING
SARA_DEBUG=0

# Voice providers (optional)
VOICE_STT_PROVIDER=deepgram
VOICE_TTS_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# `multi` is recommended for Urdu + English code-switching; use `ur` only
# when callers are expected to speak Urdu without English terms.
DEEPGRAM_LANGUAGE=multi
DEEPGRAM_SMART_FORMAT=1
DEEPGRAM_TIMEOUT_SECONDS=20
DEEPGRAM_STREAM_ENDPOINTING_MS=100
DEEPGRAM_STREAM_UTTERANCE_END_MS=1000
DEEPGRAM_KEYTERMS=purchase,property,rent,budget,crore,lakh,apartment,flat,house,plot,bedroom,DHA,Lahore,Islamabad,Karachi,Bahria Town,Gulberg,flexible,developer,parking,gym,teen crore,do crore,char crore,paanch crore,ghar khareedna,property purchase,property rent,monthly rent,payment plan,ready possession,DHA Phase 1,DHA Phase 2,DHA Phase 3,DHA Phase 4,DHA Phase 5,DHA Phase 6,DHA Phase 7,DHA Phase 8,DHA Phase 9
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
VOICE_API_TIMEOUT_SECONDS=30
VOICE_API_MAX_RETRIES=1
SARA_TTS_MAX_CHARS=2500
SARA_TTS_PROVIDER=deepgram
SARA_TTS_FALLBACK_PROVIDER=edge-tts
SARA_VOICE_GREETING_ENABLED=1
# Optional: override Sara's opening real-estate introduction.
# SARA_VOICE_GREETING=Assalam-o-Alaikum! Main Sara hoon...
DEEPGRAM_TTS_MODEL=flux-priya-en
DEEPGRAM_TTS_ENCODING=mp3
DEEPGRAM_TTS_SPEED=1.0
DEEPGRAM_TTS_EXPRESSIVITY=0
DEEPGRAM_TTS_TIMEOUT_SECONDS=45
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
# Optional saved voice-model ID. Leave blank to use the account default.
FISH_AUDIO_REFERENCE_ID=
# Compatibility aliases also supported: FISH_AUDIO_VOICE_ID and
# FISH_AUDIO_OUTPUT_FORMAT.
FISH_AUDIO_FORMAT=mp3
FISH_AUDIO_LATENCY=balanced
FISH_AUDIO_SAMPLE_RATE=44100
FISH_AUDIO_MP3_BITRATE=128
FISH_AUDIO_SPEED=1.0
FISH_AUDIO_CHUNK_LENGTH=200
FISH_AUDIO_TIMEOUT_SECONDS=60

# Server
HOST=127.0.0.1
PORT=8000
