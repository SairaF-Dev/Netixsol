 },
 "components": {
  "schemas": {
   "AnswerIn": {
    "properties": {
     "question": {
      "type": "string",
      "maxLength": 60,
      "title": "Question"
     },
     "choice": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 9.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Choice"
     },
     "text": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 300
       },
       {
        "type": "null"
       }
      ],
      "title": "Text"
     }
    },
    "type": "object",
    "required": [
     "question"
    ],
    "title": "AnswerIn"
   },
   "AskIn": {
    "properties": {
     "message": {
      "type": "string",
      "maxLength": 1500,
      "minLength": 1,
      "title": "Message"
     },
     "language": {
      "type": "string",
      "pattern": "^(auto|english|urdulish)$",
      "title": "Language",
      "default": "auto"
     }
    },
    "type": "object",
    "required": [
     "message"
    ],
    "title": "AskIn"
   },
   "DecisionIn": {
    "properties": {
     "decision": {
      "type": "string",
      "maxLength": 60,
      "title": "Decision"
     },
     "note": {
      "type": "string",
      "maxLength": 500,
      "title": "Note",
      "default": ""
     }
    },
    "type": "object",
    "required": [
     "decision"
    ],
    "title": "DecisionIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "HintIn": {
    "properties": {
     "exercise": {
      "type": "string",
      "maxLength": 60,
      "title": "Exercise"
     },
     "code": {
      "type": "string",
      "maxLength": 20000,
      "title": "Code",
      "default": ""
     },
     "message": {
      "type": "string",
      "maxLength": 1500,
      "title": "Message",
      "default": ""
     },
     "level": {
      "type": "integer",
      "maximum": 4.0,
      "minimum": 1.0,
      "title": "Level",
      "default": 1
     },
     "language": {
      "type": "string",
      "pattern": "^(auto|english|urdulish)$",
      "title": "Language",
      "default": "auto"
     }
    },
    "type": "object",
    "required": [
     "exercise"
    ],
    "title": "HintIn"
   },
   "LoginIn": {
    "properties": {
     "username": {
      "type": "string",
      "maxLength": 40,
      "minLength": 1,
      "title": "Username"
     },
     "password": {
      "type": "string",
      "maxLength": 200,
      "minLength": 1,
      "title": "Password"
     }
    },
    "type": "object",
    "required": [
     "username",
     "password"
    ],
    "title": "LoginIn"
   },
   "QuestionDecisionIn": {
    "properties": {
     "decision": {
      "type": "string",
      "maxLength": 20,
      "title": "Decision"
     },
     "level": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 5.0,
        "minimum": 1.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Level"
     }
    },
    "type": "object",
    "required": [
     "decision"
    ],
    "title": "QuestionDecisionIn"
   },
   "SubmissionIn": {
    "properties": {
     "exercise": {
      "type": "string",
      "maxLength": 60,
      "title": "Exercise"
     },
     "code": {
      "type": "string",
      "maxLength": 20000,
      "title": "Code"
     }
    },
    "type": "object",
    "required": [
     "exercise",
     "code"
    ],
    "title": "SubmissionIn"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}