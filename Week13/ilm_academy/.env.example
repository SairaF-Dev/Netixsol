# Copy this file to .env and fill in real values. .env is git-ignored.

# LLM provider for question drafting (Day 1) and the tutor (Day 3)
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Whisper settings (CPU defaults; use "medium" or "large-v3" on a GPU)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Embedding model used for the vector DB
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
