# ShopKaro Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.
# DO NOT commit real secrets, API keys, or production credentials to source control.

# Application Configuration
APP_ENV=development
APP_NAME=ShopKaro
DEBUG=True
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Database & Storage
DATABASE_URL=
DUCKDB_PATH=data/processed/shopkaro.duckdb
REDIS_URL=

# Large Language Model & Conversational Assistant
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-3.1-flash-lite
# auto = use the LLM when LLM_API_KEY is set, else rule-based | llm | rules
ASSISTANT_ENGINE=auto

# Search: neural embeddings (auto = on when sentence-transformers is installed) and cross-encoder re-ranking of the
# top 50 results (adds ~0.7 s per search on a laptop CPU; set to off for a faster demo).
SEARCH_EMBEDDINGS=auto
# Homepage recommender: item_cf | two_tower (two_tower needs: python scripts/precompute_recommendations.py --two-tower)
RECOMMENDER=item_cf
SEARCH_CROSS_ENCODER=auto
LLM_TIMEOUT_SECONDS=20

# Model Artifacts & File Paths
MODEL_DIR=models
DATA_DIR=data

